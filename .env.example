# App (dev + docker). Copy to .env.
DATABASE_URL="postgresql://postgres:admin@localhost:5431/laundrypoint?schema=public"
PORT=3000
NODE_ENV=development
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="12h"
CORS_ORIGIN=""

# ── docker-compose only ──
IMAGE=ghcr.io/OWNER/laundrypoint
TAG=latest
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
POSTGRES_DB=laundrypoint
DB_PORT=5431
APP_PORT=3000
RUN_MIGRATIONS=true
RUN_SEED=false
