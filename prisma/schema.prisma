// Laundry Point POS — database design
// Mirrors the cashier frontend domain (see system/cashier).
// Flow: Outlet → Employee (PIN auth) → Order (cart of Services) → Payment.

generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; the musl target matches the node:alpine container.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Enums ───────────────────────────

enum EmployeeRole {
  KASIR
  CUCI_KERING
  SETRIKA
  PACKING
  OWNER
}

enum EmployeeStatus {
  ONLINE
  WORKING
  OFFLINE
}

enum ServiceCategory {
  KILOAN
  NON_KILOAN
  THIRD_PARTY
}

// Paket layanan — harga Reguler & Sameday beda. 3rd party tidak punya paket (null).
enum ServicePackage {
  REGULER
  SAMEDAY
}

enum ServiceUnit {
  KG
  PCS
  METER
  PASANG
}

// Kanban / workstation stages an order moves through.
enum OrderStatus {
  ANTRIAN // received at cashier, queued
  CUCI // wash & dry station
  SETRIKA // ironing station
  PACKING // packing / return station
  SIAP_AMBIL // ready for pickup
  SELESAI // handed to customer
  BATAL // cancelled
}

enum PaymentStatus {
  BELUM_BAYAR // OPEN BILL — pay on pickup
  LUNAS // closed bill — paid
}

enum PaymentMethod {
  CASH
  QRIS_BTN
  QRIS_GOPAY
  TRANSFER
}

// When the customer pays.
enum PayTiming {
  NOW // bayar sekarang
  PICKUP // bayar saat ambil
}

enum MachineType {
  WASHER // mesin cuci
  DRYER // pengering
}

enum MachineStatus {
  IDLE // kosong · siap pakai
  RUNNING // sedang jalan
  DONE // selesai · siap dipindah
  MAINTENANCE // perbaikan
}

enum AdjustmentStatus {
  PENDING // menunggu approval
  APPROVED // disetujui — diterapkan ke sortedLoad
  REJECTED // ditolak
}

// ─────────────────────────── Models ──────────────────────────

model Outlet {
  id        String     @id @default(cuid())
  name      String
  address   String?
  phone     String?
  instagram String?
  employees Employee[]
  orders    Order[]
  machines  Machine[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Employee {
  id           String         @id @default(cuid())
  name         String
  email        String?        @unique
  passwordHash String? // outlet/admin login (email + password)
  pinHash      String // 4-digit PIN for station login
  role         EmployeeRole
  status       EmployeeStatus @default(OFFLINE)
  color        String? // avatar color, e.g. "#5b9df9"
  note         String? // e.g. "Shift pagi · belum login"
  avatarUrl    String?
  lastSeenAt   DateTime?
  outlet       Outlet?        @relation(fields: [outletId], references: [id])
  outletId     String?
  orders       Order[]        @relation("CashierOrders")
  attendances  Attendance[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([outletId])
  @@index([role])
}

model Customer {
  id          String   @id @default(cuid())
  name        String
  phone       String   @unique
  address     String? // alamat pelanggan (free text)
  memberTier  String? // e.g. "Member 5%"
  discountPct Int      @default(0)
  orders      Order[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([phone])
}

model Service {
  id        String          @id @default(cuid())
  slug      String          @unique // 'reguler', 'selimut', 'sepatu'
  name      String
  subtitle  String?
  emoji     String?
  price     Int // rupiah per unit
  unit      ServiceUnit
  step      Float           @default(1) // qty increment (0.1 for kg, 1 for pcs)
  minQty    Float? // minimum billable qty (e.g. Reguler 5kg, Sameday 3kg)
  needsWash Boolean         @default(true) // false for "Setrika Saja"
  needsIron Boolean         @default(true) // false for "Cuci Saja" / non-kiloan
  category  ServiceCategory
  package   ServicePackage? // null = 3rd party (tanpa paket)
  duration  String? // lead time kalau beda dari default paket, e.g. "3 hari"
  active    Boolean         @default(true)
  items     OrderItem[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([category])
}

model Order {
  id            String        @id @default(cuid())
  noNota        String        @unique // e.g. "LP-2405-1234"
  outlet        Outlet?       @relation(fields: [outletId], references: [id])
  outletId      String?
  customer      Customer?     @relation(fields: [customerId], references: [id])
  customerId    String?
  cashier       Employee?     @relation("CashierOrders", fields: [cashierId], references: [id])
  cashierId     String?
  status        OrderStatus   @default(ANTRIAN)
  paymentStatus PaymentStatus @default(BELUM_BAYAR)
  notes         String?
  delivery      Boolean       @default(false)
  package       ServicePackage? // 1 nota = 1 paket; null = 3rd party
  scalePhoto    String?       @db.Text // foto timbangan (base64), dikirim bareng nota WA
  discountPct   Int           @default(0)
  subtotal      Int           @default(0)
  discount      Int           @default(0)
  total         Int           @default(0)
  estimasi      String? // human label, e.g. "Sen, 27 Mei"
  estimatedAt   DateTime?
  rackLabel     String? // shelf/rack location once packed (e.g. "R-12")
  packPhoto     String?  @db.Text // photo of the folded/packed laundry (base64)
  ironPhoto     String?  @db.Text // "Foto Hasil" — documentation photo at Setrika
  washPhoto     String?  @db.Text // foto cucian setelah Cek & Pilah (station Cuci & Kering)
  needsWash     Boolean  @default(true) // routing: false → skip Cuci
  needsIron     Boolean  @default(true) // routing: false → skip Setrika
  items         OrderItem[]
  payments      Payment[]
  machines      Machine[]     @relation("MachineOrder") // 1 mesin per basket (putih / hitam)
  adjustments   OrderAdjustment[]
  lostFound     LostFound[]
  damageReports DamageReport[]
  washLog       WashLog?
  checks        StationCheck[]
  brandedItems  BrandedItem[]
  swapsOut      ItemSwap[]    @relation("SwapFrom")
  swapsIn       ItemSwap[]    @relation("SwapTo")
  sortedLoad    Json? // hasil "Cek & Pilah Cucian" (basket putih/hitam/satuan)
  intakeCount   Json? // hitungan kasir saat terima: { putih, hitam, satuan, byName, at }
  workers       Json? // yang mengerjakan per station: { "Setrika": [{ id, name }] }
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
  @@index([customerId])
  @@index([createdAt])
}

// A requested reduction of sorted items — needs approval before it applies.
model OrderAdjustment {
  id              String           @id @default(cuid())
  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId         String
  status          AdjustmentStatus @default(PENDING)
  reason          String?
  photo           String?          @db.Text // foto kekurangan (opsional)
  changes         Json // [{ basket, itemId, name, emoji, fromQty, toQty }]
  requestedById   String?
  requestedByName String?
  reviewedById    String?
  reviewedByName  String?
  reviewedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([orderId])
  @@index([status])
}

// A work shift opened by an employee (3 fixed shifts of 5h/day).
model Shift {
  id           String    @id @default(cuid())
  shiftNo      Int // 1 | 2 | 3
  employeeId   String?
  employeeName String?
  openedAt     DateTime  @default(now())
  closedAt     DateTime?
  status       String    @default("open") // open | closed

  @@index([status])
}

// A lost-and-found item logged at a station, optionally with a photo.
model LostFound {
  id             String   @id @default(cuid())
  order          Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId        String?
  description    String
  photo          String?  @db.Text // data URL (base64), compressed client-side
  station        String? // e.g. "Setrika"
  status         String   @default("open") // open | claimed
  reportedById   String?
  reportedByName String?
  createdAt      DateTime @default(now())

  @@index([orderId])
  @@index([status])
}

// A damage report (sobek / luntur / noda) logged at any station, with a photo.
model DamageReport {
  id             String   @id @default(cuid())
  order          Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId        String?
  description    String
  photo          String?  @db.Text
  station        String? // e.g. "Cuci & Kering", "Setrika"
  status         String   @default("open") // open | resolved
  reportedById   String?
  reportedByName String?
  createdAt      DateTime @default(now())

  @@index([orderId])
  @@index([status])
}

model Machine {
  id             String        @id @default(cuid())
  name           String // "Mesin Cuci A", "Pengering 1"
  type           MachineType
  status         MachineStatus @default(IDLE)
  capacityKg     Float?
  outlet         Outlet?       @relation(fields: [outletId], references: [id])
  outletId       String?
  currentOrder   Order?        @relation("MachineOrder", fields: [currentOrderId], references: [id])
  currentOrderId String?
  currentBasket  String? // "putih" | "hitam" | "satuan" — basket order yang sedang di mesin ini
  startedAt      DateTime?
  durationMin    Int? // planned cycle length in minutes
  lastUsedAt     DateTime?
  maintenance    MaintenanceRecord[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([type])
  @@index([status])
  @@index([currentOrderId])
}

// Satu baris lembar "Divisi Cuci — Washer & Dryer" per nota. Baris muncul di laporan setelah `finishedAt` terisi.
model WashLog {
  id           String    @id @default(cuid())
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId      String    @unique
  washers      String[] // nama mesin cuci yang dipakai (mesinnya sudah dilepas saat laporan dibuat)
  tower        String? // tower / cluster; kosong = alamat pelanggan
  bedDuvet     Int       @default(0) // bedcover: Bed S / Duvet
  sb           Int       @default(0) // bedcover: SB
  sg           Int       @default(0) // bedcover: SG
  notes        String?
  operatorName String?
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([finishedAt])
}

// Catatan kondisi mesin setrika (mesin uap / mesin air). Bahan habis pakai ada di InventoryItem.
model SupplyLog {
  id           String   @id @default(cuid())
  kind         String // "uap" | "air"
  qty          Float
  note         String?
  employeeName String?
  recordedAt   DateTime @default(now()) // jam & hari pencatatan, bisa diedit
  createdAt    DateTime @default(now())

  @@index([kind, recordedAt])
}



// Barang fisik yang dipindah antar nota ("Mencari Jarum di Tumpukan Jerami"). Jumlah tercatat tidak berubah.
model ItemSwap {
  id          String   @id @default(cuid())
  fromOrder   Order    @relation("SwapFrom", fields: [fromOrderId], references: [id], onDelete: Cascade)
  fromOrderId String
  toOrder     Order    @relation("SwapTo", fields: [toOrderId], references: [id], onDelete: Cascade)
  toOrderId   String
  basket      String // "putih" | "hitam" | "satuan"
  qty         Int
  byName      String?
  createdAt   DateTime @default(now())

  @@index([fromOrderId])
  @@index([toOrderId])
}


model OrderItem {
  id        String          @id @default(cuid())
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  service   Service?        @relation(fields: [serviceId], references: [id])
  serviceId String?
  // snapshot fields — kept even if the Service later changes/deletes
  name      String
  subtitle  String?
  price     Int // unit price at time of order
  unit      ServiceUnit
  category  ServiceCategory
  duration  String?
  qty       Float
  lineTotal Int
  createdAt DateTime        @default(now())

  @@index([orderId])
}

model Payment {
  id           String        @id @default(cuid())
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId      String
  method       PaymentMethod
  timing       PayTiming     @default(NOW)
  amount       Int // amount charged (order total)
  cashReceived Int?
  change       Int?
  paidAt       DateTime      @default(now())

  @@index([orderId])
}

// ── Inventory per station ─────────────────────────────────────
// Stok = total "masuk" − total "pakai"; tidak disimpan supaya tidak pernah selisih dari riwayatnya.
model InventoryItem {
  id          String          @id @default(cuid())
  station     String // "cuci" | "setrika" | "packing" | "kasir"
  name        String
  unit        String // "pouch", "tabung", "pcs", …
  machineType MachineType? // diisi = pemakaian wajib pilih mesin jenis ini (mis. gas → DRYER)
  active      Boolean         @default(true)
  moves       InventoryMove[]
  createdAt   DateTime        @default(now())

  @@unique([station, name])
}

model InventoryMove {
  id           String        @id @default(cuid())
  item         InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId       String
  type         String // "masuk" | "pakai"
  qty          Float
  note         String?
  machineId    String?
  machineName  String?
  employeeName String?
  recordedAt   DateTime      @default(now()) // jam & hari kejadian, bisa diedit
  createdAt    DateTime      @default(now())

  @@index([itemId, recordedAt])
}

// ── Maintenance ───────────────────────────────────────────────
// RUSAK / MAINTENANCE: per mesin, dibuka lalu ditandai selesai (mesin "perbaikan" selama terbuka).
// CEROBONG: cerobong asap pengering, hanya mencatat hasil (langsung selesai).
model MaintenanceRecord {
  id           String    @id @default(cuid())
  kind         String // "RUSAK" | "MAINTENANCE" | "CEROBONG"
  machine      Machine?  @relation(fields: [machineId], references: [id], onDelete: SetNull)
  machineId    String?
  machineName  String? // disalin: laporan tetap utuh walau mesin dihapus
  note         String?
  status       String    @default("open") // "open" | "done"
  doneNote     String?
  openedByName String?
  doneByName   String?
  openedAt     DateTime  @default(now())
  doneAt       DateTime?

  @@index([status])
  @@index([openedAt])
}

// ── Absen per station ─────────────────────────────────────────
model Attendance {
  id         String    @id @default(cuid())
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String
  station    String // StationKey frontend: "cashier" | "dry-and-clean" | "ironing" | "packing" | "pengembalian"
  checkInAt  DateTime  @default(now())
  checkOutAt DateTime?

  @@index([station, checkInAt])
}

// Hasil hitung ulang per nota di tiap station (setrika, packing), disalin supaya laporan tetap sama
// walau jumlahnya disesuaikan Owner.
model StationCheck {
  id           String   @id @default(cuid())
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId      String
  station      String // "setrika" | "packing"
  baskets      Json // [{ key, expected, counted }]
  operatorName String?
  checkedAt    DateTime @default(now())

  @@unique([orderId, station])
  @@index([station, checkedAt])
}

// Barang branded / baru milik pelanggan — dicatat kasir, ikut terlihat sampai serah terima.
model BrandedItem {
  id             String   @id @default(cuid())
  order          Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId        String?
  description    String
  photo          String?  @db.Text
  station        String?
  status         String   @default("open") // open | resolved (sudah diserahkan)
  reportedById   String?
  reportedByName String?
  createdAt      DateTime @default(now())

  @@index([orderId])
}
